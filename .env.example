# Local-only sync config for scripts/sync-to-ed-harness.mjs
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.

# Required — GitHub repo to receive the sync (develop branch by default)
EDHARNESS_REPO_URL=https://github.com/<owner>/<repo>

# Optional (default: develop)
EDHARNESS_BRANCH=develop
