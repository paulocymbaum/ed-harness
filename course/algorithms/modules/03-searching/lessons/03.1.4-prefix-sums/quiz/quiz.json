{
  "id": "quiz",
  "title": "Prefix Sums Check",
  "description": "Prefix construction and range-sum formulas.",
  "lessonId": "03.1.4-prefix-sums",
  "graphIndex": "03.1.4",
  "questions": [
    {
      "id": "q1",
      "prompt": "With `arr = [2, 4, 1, 3]` and sentinel `prefix[0]=0`, `sum(arr[1..3])` is:",
      "options": [
        {
          "id": "a",
          "text": "`prefix[3] - prefix[1]`"
        },
        {
          "id": "b",
          "text": "`prefix[4] - prefix[1]`"
        },
        {
          "id": "c",
          "text": "`prefix[3] - prefix[0]`"
        },
        {
          "id": "d",
          "text": "`prefix[4] - prefix[0]`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Inclusive `[L,R]` uses `prefix[R+1] - prefix[L]`. Here `L=1`, `R=3` → `prefix[4]-prefix[1]`."
    },
    {
      "id": "q2",
      "prompt": "Building a 1D prefix array for length `n` is typically:",
      "options": [
        {
          "id": "a",
          "text": "`O(1)`"
        },
        {
          "id": "b",
          "text": "`O(log n)`"
        },
        {
          "id": "c",
          "text": "`O(n)`"
        },
        {
          "id": "d",
          "text": "`O(n²)`"
        }
      ],
      "correctOptionId": "c",
      "explanation": "One forward pass accumulates running totals → `O(n)`."
    },
    {
      "id": "q3",
      "prompt": "After prefixes are built, one inclusive range-sum query is:",
      "options": [
        {
          "id": "a",
          "text": "`O(n)` rescan"
        },
        {
          "id": "b",
          "text": "`O(1)` using two prefix lookups"
        },
        {
          "id": "c",
          "text": "`O(n log n)`"
        },
        {
          "id": "d",
          "text": "`O(k)` where `k` is always `n`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "`prefix[R+1] - prefix[L]` is two array reads → constant time."
    },
    {
      "id": "q4",
      "prompt": "Why keep `prefix[0] = 0`?",
      "options": [
        {
          "id": "a",
          "text": "So ranges starting at index `0` use the same formula"
        },
        {
          "id": "b",
          "text": "Because arrays cannot store positives"
        },
        {
          "id": "c",
          "text": "It makes binary search mandatory"
        },
        {
          "id": "d",
          "text": "It halves memory automatically"
        }
      ],
      "correctOptionId": "a",
      "explanation": "The sentinel keeps `sum(0,R) = prefix[R+1] - prefix[0]` uniform with other ranges."
    }
  ]
}
