{
  "id": "quiz",
  "title": "Backtracking Search Check",
  "description": "Choose/explore/undo and combination trees.",
  "lessonId": "03.4.4-backtracking-search",
  "graphIndex": "03.4.4",
  "questions": [
    {
      "id": "q1",
      "prompt": "The essential backtracking trio is:",
      "options": [
        {
          "id": "a",
          "text": "Sort, hash, binary search"
        },
        {
          "id": "b",
          "text": "Choose, explore, undo"
        },
        {
          "id": "c",
          "text": "Map, Set, WeakMap"
        },
        {
          "id": "d",
          "text": "Enqueue, dequeue, peek only"
        }
      ],
      "correctOptionId": "b",
      "explanation": "You commit a choice, recurse, then pop/undo before the next try."
    },
    {
      "id": "q2",
      "prompt": "Combinations of size 2 from `1..3` number:",
      "options": [
        {
          "id": "a",
          "text": "`2`"
        },
        {
          "id": "b",
          "text": "`3`"
        },
        {
          "id": "c",
          "text": "`6`"
        },
        {
          "id": "d",
          "text": "`9`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "`[1,2]`, `[1,3]`, `[2,3]` — three combinations."
    },
    {
      "id": "q3",
      "prompt": "Skipping `path.pop()` after the recursive call typically:",
      "options": [
        {
          "id": "a",
          "text": "Speeds up without changing results"
        },
        {
          "id": "b",
          "text": "Corrupts later branches via shared mutable state"
        },
        {
          "id": "c",
          "text": "Converts backtracking into BFS"
        },
        {
          "id": "d",
          "text": "Guarantees pruning"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Without undo, the path keeps growing across sibling choices."
    },
    {
      "id": "q4",
      "prompt": "Recording a solution should usually:",
      "options": [
        {
          "id": "a",
          "text": "Push the same `path` reference and mutate later freely"
        },
        {
          "id": "b",
          "text": "Copy the path (`[...path]`) before storing"
        },
        {
          "id": "c",
          "text": "Delete the path array"
        },
        {
          "id": "d",
          "text": "Store only the last number"
        }
      ],
      "correctOptionId": "b",
      "explanation": "The mutable `path` continues changing; store a snapshot."
    }
  ]
}
