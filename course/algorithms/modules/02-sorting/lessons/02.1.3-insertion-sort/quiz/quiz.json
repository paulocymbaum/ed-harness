{
  "id": "quiz",
  "title": "Insertion Sort Check",
  "description": "Slots, shifts, best case, and stability.",
  "lessonId": "02.1.3-insertion-sort",
  "graphIndex": "02.1.3",
  "questions": [
    {
      "id": "q1",
      "prompt": "Inserting `2` into sorted prefix `[1, 3, 5]` lands at index:",
      "options": [
        {
          "id": "a",
          "text": "0"
        },
        {
          "id": "b",
          "text": "1"
        },
        {
          "id": "c",
          "text": "2"
        },
        {
          "id": "d",
          "text": "3"
        }
      ],
      "correctOptionId": "b",
      "explanation": "`2` belongs after `1` and before `3`."
    },
    {
      "id": "q2",
      "prompt": "Best-case time on sorted input is:",
      "options": [
        {
          "id": "a",
          "text": "`O(n²)`"
        },
        {
          "id": "b",
          "text": "`O(n)`"
        },
        {
          "id": "c",
          "text": "`O(log n)`"
        },
        {
          "id": "d",
          "text": "`O(1)`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Each key stops immediately; total linear work."
    },
    {
      "id": "q3",
      "prompt": "Stable insertion uses while condition:",
      "options": [
        {
          "id": "a",
          "text": "`a[j] >= key`"
        },
        {
          "id": "b",
          "text": "`a[j] > key`"
        },
        {
          "id": "c",
          "text": "`a[j] != key`"
        },
        {
          "id": "d",
          "text": "Random swaps"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Not shifting equals keeps earlier equals left."
    },
    {
      "id": "q4",
      "prompt": "Why is insertion strong on nearly sorted arrays?",
      "options": [
        {
          "id": "a",
          "text": "It is always `O(n log n)`"
        },
        {
          "id": "b",
          "text": "Few inversions mean few shifts"
        },
        {
          "id": "c",
          "text": "It skips all comparisons"
        },
        {
          "id": "d",
          "text": "It uses `O(n)` auxiliary space"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Work tracks inversions; nearly sorted ≈ linear."
    }
  ]
}
