{
  "id": "quiz",
  "title": "Bubble Sort Check",
  "description": "Adjacent swaps, passes, and complexity for bubble sort.",
  "lessonId": "02.1.1-bubble-sort",
  "graphIndex": "02.1.1",
  "questions": [
    {
      "id": "q1",
      "prompt": "In one left-to-right bubble pass on `[3, 1, 2]`, how many adjacent swaps occur?",
      "options": [
        {
          "id": "a",
          "text": "0"
        },
        {
          "id": "b",
          "text": "1"
        },
        {
          "id": "c",
          "text": "2"
        },
        {
          "id": "d",
          "text": "3"
        }
      ],
      "correctOptionId": "c",
      "explanation": "`3>1` then `3>2` → two swaps produce `[1,2,3]`."
    },
    {
      "id": "q2",
      "prompt": "With early-exit, sorted input is typically:",
      "options": [
        {
          "id": "a",
          "text": "`O(n²)` always"
        },
        {
          "id": "b",
          "text": "`O(n)` best case"
        },
        {
          "id": "c",
          "text": "`O(log n)`"
        },
        {
          "id": "d",
          "text": "`O(1)`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "One zero-swap pass proves order → linear best case."
    },
    {
      "id": "q3",
      "prompt": "Typical auxiliary memory for bubble sort is:",
      "options": [
        {
          "id": "a",
          "text": "`O(n)`"
        },
        {
          "id": "b",
          "text": "`O(n log n)`"
        },
        {
          "id": "c",
          "text": "`O(1)` beyond the array"
        },
        {
          "id": "d",
          "text": "`O(n²)`"
        }
      ],
      "correctOptionId": "c",
      "explanation": "Swaps are in place; auxiliary space is constant."
    },
    {
      "id": "q4",
      "prompt": "Bubble sort is stable when you:",
      "options": [
        {
          "id": "a",
          "text": "Always swap equals"
        },
        {
          "id": "b",
          "text": "Only swap on strictly greater"
        },
        {
          "id": "c",
          "text": "Sort descending only"
        },
        {
          "id": "d",
          "text": "Skip the early-exit check"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Not swapping equal keys preserves relative order."
    }
  ]
}
