        {
          "id": "a",
          "text": "Ascending"
        },
        {
          "id": "b",
          "text": "Descending"
        },
        {
          "id": "c",
          "text": "Randomly"
        },
        {
          "id": "d",
          "text": "As strings only"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Flipped subtraction → higher math first."
    },
    {
      "id": "q3",
      "prompt": "Successive sorts must run:",
      "options": [
        {
          "id": "a",
          "text": "Primary first if unstable is OK"
        },
        {
          "id": "b",
          "text": "Last key first, then earlier keys, with stability"
        },
        {
          "id": "c",
          "text": "Only once ever"
        },
        {
          "id": "d",
          "text": "Without comparators"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Stable sorts from weakest to strongest key."
    },
    {
      "id": "q4",
      "prompt": "If all keys tie, comparator should return:",
      "options": [
        {
          "id": "a",
          "text": "`1`"
        },
        {
          "id": "b",
          "text": "`-1`"
        },
        {
          "id": "c",
          "text": "`0`"
        },
        {
          "id": "d",
          "text": "`true`"
        }
      ],
      "correctOptionId": "c",
      "explanation": "Equal records compare as zero."
    }
