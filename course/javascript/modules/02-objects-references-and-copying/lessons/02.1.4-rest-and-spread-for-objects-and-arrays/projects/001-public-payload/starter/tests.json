{
  "cases": [
    {
      "id": "strip-sensitive",
      "name": "Drop password/secret and add default role",
      "stdin": "{\"name\":\"Ada\",\"password\":\"x\",\"secret\":\"y\"}\n",
      "expectedStdout": "{\"role\":\"user\",\"name\":\"Ada\"}\n",
      "expectedExitCode": 0
    },
    {
      "id": "keep-role",
      "name": "Input role wins over default",
      "stdin": "{\"name\":\"Bob\",\"role\":\"admin\"}\n",
      "expectedStdout": "{\"role\":\"admin\",\"name\":\"Bob\"}\n",
      "expectedExitCode": 0
    },
    {
      "id": "missing-input",
      "name": "Empty stdin",
      "stdin": "",
      "expectedStdout": "ERROR: missing input\n",
      "expectedExitCode": 0
    },
    {
      "id": "invalid-json",
      "name": "Invalid JSON",
      "stdin": "not-json\n",
      "expectedStdout": "ERROR: invalid JSON\n",
      "expectedExitCode": 0
    }
  ]
}
