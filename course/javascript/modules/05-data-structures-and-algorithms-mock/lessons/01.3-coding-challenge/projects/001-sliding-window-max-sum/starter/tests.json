{
  "cases": [
    {
      "id": "example",
      "name": "Window of 3 over a mixed array",
      "stdin": "2 1 5 1 3 2\n3\n",
      "expectedStdout": "9\n",
      "expectedExitCode": 0
    },
    {
      "id": "k-greater-than-n",
      "name": "k larger than array length is an error",
      "stdin": "1 2 3\n5\n",
      "expectedStdout": "ERROR\n",
      "expectedExitCode": 0
    },
    {
      "id": "k-less-than-one",
      "name": "k of zero is an error",
      "stdin": "1 2 3\n0\n",
      "expectedStdout": "ERROR\n",
      "expectedExitCode": 0
    },
    {
      "id": "all-negative",
      "name": "All-negative array picks the least negative window",
      "stdin": "-1 -2 -3 -4\n2\n",
      "expectedStdout": "-3\n",
      "expectedExitCode": 0
    },
    {
      "id": "k-equals-n",
      "name": "k equal to array length sums the whole array",
      "stdin": "4 5 6\n3\n",
      "expectedStdout": "15\n",
      "expectedExitCode": 0
    }
  ]
}
