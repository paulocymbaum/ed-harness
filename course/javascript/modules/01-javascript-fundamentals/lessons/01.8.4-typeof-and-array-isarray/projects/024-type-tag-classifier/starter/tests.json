{
  "cases": [
    {
      "id": "null-tag",
      "name": "null is null (not object)",
      "stdin": "null\n",
      "expectedStdout": "null\n",
      "expectedExitCode": 0
    },
    {
      "id": "empty-array",
      "name": "Empty array",
      "stdin": "[]\n",
      "expectedStdout": "array\n",
      "expectedExitCode": 0
    },
    {
      "id": "array-with-items",
      "name": "Non-empty array",
      "stdin": "[1,2]\n",
      "expectedStdout": "array\n",
      "expectedExitCode": 0
    },
    {
      "id": "plain-object",
      "name": "Plain object",
      "stdin": "{}\n",
      "expectedStdout": "object\n",
      "expectedExitCode": 0
    },
    {
      "id": "array-like",
      "name": "Array-like object is not array",
      "stdin": "{\"length\":2}\n",
      "expectedStdout": "object\n",
      "expectedExitCode": 0
    },
    {
      "id": "number",
      "name": "Number primitive",
      "stdin": "42\n",
      "expectedStdout": "number\n",
      "expectedExitCode": 0
    },
    {
      "id": "string",
      "name": "String primitive",
      "stdin": "\"hi\"\n",
      "expectedStdout": "string\n",
      "expectedExitCode": 0
    },
    {
      "id": "boolean",
      "name": "Boolean primitive",
      "stdin": "true\n",
      "expectedStdout": "boolean\n",
      "expectedExitCode": 0
    }
  ]
}
