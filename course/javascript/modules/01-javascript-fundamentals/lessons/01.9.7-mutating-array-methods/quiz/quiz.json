{
  "id": "quiz",
  "title": "Mutating Methods Check",
  "description": "In-place array changes with push/pop/splice/sort.",
  "lessonId": "01.9.7-mutating-array-methods",
  "graphIndex": "01.9.7",
  "questions": [
    {
      "id": "q1",
      "prompt": "After `const xs = [1]; xs.push(2);` what is `xs`?",
      "options": [
        {
          "id": "a",
          "text": "`[1]`"
        },
        {
          "id": "b",
          "text": "`[1, 2]`"
        },
        {
          "id": "c",
          "text": "`[2]`"
        },
        {
          "id": "d",
          "text": "`2`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "`push` mutates the same array by appending."
    },
    {
      "id": "q2",
      "prompt": "`const a = [1]; const b = a; b.push(2);` — what is `a`?",
      "options": [
        {
          "id": "a",
          "text": "`[1]`"
        },
        {
          "id": "b",
          "text": "`[1, 2]`"
        },
        {
          "id": "c",
          "text": "`[2]`"
        },
        {
          "id": "d",
          "text": "`undefined`"
        }
      ],
      "correctOptionId": "b",
      "explanation": "`a` and `b` reference the same array object."
    },
    {
      "id": "q3",
      "prompt": "What does `[\"a\", \"b\", \"c\"].splice(1, 1, \"X\")` make the array become?",
      "options": [
        {
          "id": "a",
          "text": "`[\"a\", \"X\", \"c\"]`"
        },
        {
          "id": "b",
          "text": "`[\"a\", \"b\", \"c\", \"X\"]`"
        },
        {
          "id": "c",
          "text": "`[\"X\"]`"
        },
        {
          "id": "d",
          "text": "`[\"a\", \"c\"]`"
        }
      ],
      "correctOptionId": "a",
      "explanation": "At index 1, delete 1 element and insert `\"X\"`."
    },
    {
      "id": "q4",
      "prompt": "`[3, 2, 10].sort()` without a comparator typically yields:",
      "options": [
        {
          "id": "a",
          "text": "`[2, 3, 10]`"
        },
        {
          "id": "b",
          "text": "`[10, 2, 3]`"
        },
        {
          "id": "c",
          "text": "`[3, 2, 10]` unchanged"
        },
        {
          "id": "d",
          "text": "TypeError"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Default sort compares as strings, so `\"10\"` sorts before `\"2\"`."
    }
  ]
}
